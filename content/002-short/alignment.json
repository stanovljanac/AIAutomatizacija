{
  "audio": "voice/narration.mp3",
  "duration": 31.4,
  "sentences": [
    {
      "scene": "s1",
      "index": 0,
      "text": "Here's what AI automation actually is, in plain English.",
      "start": 0.0,
      "end": 3.1
    },
    {
      "scene": "s2",
      "index": 1,
      "text": "AI is just software that reads messy input, like a sheet or an email, and makes a sensible decision.",
      "start": 3.78,
      "end": 9.68
    },
    {
      "scene": "s3",
      "index": 2,
      "text": "Automation just means a task runs by itself, on a trigger, with nobody pressing buttons.",
      "start": 10.26,
      "end": 14.96
    },
    {
      "scene": "s4",
      "index": 3,
      "text": "Put them together.",
      "start": 15.52,
      "end": 16.1
    },
    {
      "scene": "s4",
      "index": 4,
      "text": "A boring job shows up.",
      "start": 16.5,
      "end": 17.7
    },
    {
      "scene": "s4",
      "index": 5,
      "text": "The AI handles the messy part.",
      "start": 18.08,
      "end": 19.72
    },
    {
      "scene": "s4",
      "index": 6,
      "text": "And you just check the result.",
      "start": 20.18,
      "end": 21.5
    },
    {
      "scene": "s5",
      "index": 7,
      "text": "You set it up once, and it runs while your coffee is still hot.",
      "start": 21.92,
      "end": 25.24
    },
    {
      "scene": "s6",
      "index": 8,
      "text": "That's the whole channel: the boring automations everyone ignores.",
      "start": 25.64,
      "end": 29.12
    },
    {
      "scene": "s6",
      "index": 9,
      "text": "Follow The Automation Desk.",
      "start": 29.66,
      "end": 30.9
    }
  ],
