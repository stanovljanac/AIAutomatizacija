  "sentences": [
    {
      "scene": "s1",
      "index": 0,
      "text": "Sorting invoice emails by hand eats about a day every month.",
      "start": 0,
      "end": 3
    },
    {
      "scene": "s1",
      "index": 1,
      "text": "Here are three tiny automations that hand it back.",
      "start": 3,
      "end": 5.5
    },
    {
      "scene": "s2",
      "index": 0,
      "text": "First, auto-label invoices by sender.",
      "start": 5.5,
      "end": 8
    },
    {
      "scene": "s2",
      "index": 1,
      "text": "Second, pull the amount and due date into a sheet.",
      "start": 8,
      "end": 11
    },
    {
      "scene": "s2",
      "index": 2,
      "text": "Third, flag anything overdue for a reply.",
      "start": 11,
      "end": 13.5
    },
    {
      "scene": "s3",
      "index": 0,
      "text": "Start with one of these and scale it to your own inbox.",
      "start": 13.5,
      "end": 16.5
    },
    {
      "scene": "s3",
      "index": 1,
      "text": "Subscribe for more boring automations that quietly save hours.",
      "start": 16.5,
      "end": 20
    }
  ],
