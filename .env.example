# Copy to .env (git-ignored) and fill in. NEVER commit real values.

# Free stock APIs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# YouTube Data API v3 — store client_secret.json OUTSIDE the repo and point here
YOUTUBE_CLIENT_SECRET_PATH=

# Voice: edge-tts (free) is DRAFTS only. The FINAL/published voice uses Azure AI
# Speech (same Andrew voice, licensed, 500k chars/month free). Create a free Azure
# Speech resource and put its key + region here (D-024).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Phase B/C (autonomous studio) ─────────────────────────────────────────────
# Review panel, 2nd reviewer (Gemini). The 1st reviewer is a Sonnet sub-agent and
# needs NO key. Gemini has a free tier (no card): get a key at
#   https://aistudio.google.com/apikey   (Google AI Studio → "Create API key")
# This is the ONLY key you must add for the multi-model review loop to run.
GEMINI_API_KEY=

# Optional 3rd reviewer (disabled by default in config): Groq free tier (Meta Llama).
#   https://console.groq.com/keys
GROQ_API_KEY=

# YouTube: where the OAuth token.json is written/read (OUTSIDE the repo). One-time
# consent in the browser mints it; after that uploads are automatic.
YOUTUBE_TOKEN_PATH=

# Notifications for the 2 human gates in headless/scheduled mode (email digest). Optional.
NOTIFY_EMAIL=
