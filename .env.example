# Copy to .env (git-ignored) and fill in. NEVER commit real values.

# Free stock APIs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# YouTube Data API v3 — store client_secret.json OUTSIDE the repo and point here
YOUTUBE_CLIENT_SECRET_PATH=C:\secure\client_secret.json

# Optional paid fallback for voice (only if free Serbian TTS quality is insufficient)
ELEVENLABS_API_KEY=
