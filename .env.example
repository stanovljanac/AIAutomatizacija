# Copy to .env (git-ignored) and fill in. NEVER commit real values.

# Free stock APIs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# YouTube Data API v3 — store client_secret.json OUTSIDE the repo and point here
YOUTUBE_CLIENT_SECRET_PATH=C:\secure\client_secret.json

# Voice: edge-tts (free) is DRAFTS only. The FINAL/published voice uses Azure AI
# Speech (same Andrew voice, licensed, 500k chars/month free). Create a free Azure
# Speech resource and put its key + region here (D-024).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
