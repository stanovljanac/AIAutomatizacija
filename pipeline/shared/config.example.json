{
  "language": "en",
  "voice": {
    "provider": "edge-tts",
    "final_provider": "azure",
    "edge_tts": {
      "voice": "en-US-AndrewMultilingualNeural",
      "rate": "+8%",
      "pitch": "+0Hz"
    },
    "azure": {
      "voice": "en-US-AndrewMultilingualNeural",
      "rate": "+8%",
      "key_env": "AZURE_SPEECH_KEY",
      "region_env": "AZURE_SPEECH_REGION"
    },
    "target_wpm": 160,
    "loudness_lufs": -16
  },
  "render": {
    "engine": "remotion",
    "fps": 30,
    "long": { "width": 1920, "height": 1080 },
    "short": { "width": 1080, "height": 1920 }
  },
  "paths": {
    "content": "content",
    "assets": "assets",
    "remotion": "templates/remotion"
  },
  "defaults": {
    "long_seconds": 360,
    "short_seconds": 55,
    "short_seconds_max": 120
  },
  "stock": {
    "pexels_enabled": true,
    "pixabay_enabled": true
  },
  "ai_images": {
    "enabled": false,
    "compute": "colab"
  },
  "youtube": {
    "client_secret_path_env": "YOUTUBE_CLIENT_SECRET_PATH",
    "upload_privacy": "private"
  },
  "review": {
    "script_max_loops": 3,
    "qa_autofix_technical": true,
    "qa_flag_content": true
  }
}
