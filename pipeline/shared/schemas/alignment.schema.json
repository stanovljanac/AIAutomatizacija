{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "alignment.json",
  "type": "object",
  "required": ["audio", "duration", "sentences"],
  "properties": {
    "audio": { "type": "string" },
    "duration": { "type": "number" },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene", "index", "text", "start", "end"],
        "properties": {
          "scene": { "type": "string" },
          "index": { "type": "integer" },
          "text": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" }
        }
      }
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene", "w", "start", "end"],
        "properties": {
          "scene": { "type": "string" },
          "w": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" }
        }
      }
    }
  }
}
