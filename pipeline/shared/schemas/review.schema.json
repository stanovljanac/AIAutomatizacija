{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review.json",
  "description": "Result of one multi-model review pass over a single stage (idea | script | scene-plan | cut | publish). Holds each reviewer's independent score + the merged verdict that drives the loop and the gate bands. The 'idea' stage is the pre-script content-value pass; 'publish' reviews the metadata package (SEO/claims) before the owner sees it; the others judge how the work is made.",
  "type": "object",
  "required": ["stage", "iteration", "reviewers", "verdict", "created"],
  "properties": {
    "stage": {
      "type": "string",
      "enum": ["idea", "script", "scene-plan", "cut", "publish"],
      "description": "Which artifact this review covers ('idea' = the topic, pre-script; 'publish' = the metadata package)."
    },
    "target": { "type": "string", "description": "Path or id of the reviewed artifact." },
    "iteration": { "type": "integer", "minimum": 0, "description": "Loop iteration (0-based)." },
    "created": { "type": "string", "description": "ISO timestamp." },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per independent reviewer (e.g. claude-subagent, gemini).",
      "items": {
        "type": "object",
        "required": ["reviewer", "model", "score", "hard_gates", "category_scores"],
        "properties": {
          "reviewer": { "type": "string", "description": "Adapter name, e.g. claude-subagent | gemini | groq." },
          "model": { "type": "string", "description": "Concrete model id used." },
          "score": { "type": "number", "minimum": 0, "maximum": 10, "description": "Final 0-10 score (capped by hard gates)." },
          "hard_gates": {
            "type": "object",
            "description": "Binary gates (stage-specific keys); any false caps the score and blocks auto-pass. The required keys per stage are enforced by the top-level allOf.",
            "additionalProperties": { "type": "boolean" }
          },
          "category_scores": {
            "type": "object",
            "description": "1-10 per scored category (stage-specific keys; weights live in config.review.panel). Required keys per stage are enforced by the top-level allOf.",
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 10 }
          },
          "fixes": {
            "type": "array",
            "description": "Concrete, actionable fixes for the author to merge.",
            "items": {
              "type": "object",
              "required": ["severity", "note"],
              "properties": {
                "severity": { "type": "string", "enum": ["blocker", "major", "minor", "nit"] },
                "area": { "type": "string", "description": "e.g. hook, accuracy, pacing, captions." },
                "scene_id": { "type": ["string", "null"] },
                "note": { "type": "string" }
              }
            }
          },
          "summary": { "type": "string" }
        }
      }
    },
    "merged": {
      "type": "object",
      "description": "How the author (not a reviewer) combined the best fixes.",
      "properties": {
        "author_model": { "type": "string" },
        "applied_fixes": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["band", "proceed"],
      "properties": {
        "min_score": { "type": "number", "description": "Lowest reviewer score this iteration." },
        "both_pass": { "type": "boolean", "description": "All reviewers >= score_threshold (9)." },
        "hard_gate_ok": { "type": "boolean", "description": "All hard gates green across reviewers." },
        "band": {
          "type": "string",
          "enum": ["auto", "soft", "pause", "fail"],
          "description": "auto = >=9.2 & gates ok (skip human script gate); soft = >=9 (show owner); pause = <9 after cap; fail = hard-gate fail."
        },
        "proceed": { "type": "boolean", "description": "Whether the pipeline may advance past this stage." }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["stage"], "properties": { "stage": { "enum": ["script", "scene-plan", "cut"] } } },
      "then": {
        "properties": {
          "reviewers": {
            "items": {
              "properties": {
                "hard_gates": { "required": ["accuracy", "original_angle", "synthetic_data", "on_screen_source"] },
                "category_scores": { "required": ["retention_structure", "originality_depth", "hard_rule_craft", "style_tone", "readaloud_clarity"] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["stage"], "properties": { "stage": { "const": "idea" } } },
      "then": {
        "properties": {
          "reviewers": {
            "items": {
              "properties": {
                "hard_gates": { "required": ["value_type_present", "takeaway_present", "on_brand"] },
                "category_scores": { "required": ["audience_value", "reusable_takeaway", "transformation", "packaging", "audience_fit"] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["stage"], "properties": { "stage": { "const": "publish" } } },
      "then": {
        "properties": {
          "reviewers": {
            "items": {
              "properties": {
                "hard_gates": { "required": ["accuracy", "no_overpromise", "disclosure_set"] },
                "category_scores": { "required": ["title_ctr", "seo_keywords", "answer_first_description", "metadata_consistency"] }
              }
            }
          }
        }
      }
    }
  ]
}
