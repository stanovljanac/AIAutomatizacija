{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "qa.report.json",
  "type": "object",
  "required": ["pass", "checks"],
  "properties": {
    "pass": { "type": "boolean" },
    "checked_at": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pass", "severity"],
        "properties": {
          "name": { "type": "string" },
          "pass": { "type": "boolean" },
          "detail": { "type": "string" },
          "scene": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "fix": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
