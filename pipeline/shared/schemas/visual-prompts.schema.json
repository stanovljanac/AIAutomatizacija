{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "visual-prompts.json",
  "type": "object",
  "required": ["id", "assets"],
  "properties": {
    "id": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene", "visual_type"],
        "properties": {
          "scene": { "type": "string" },
          "visual_type": { "type": "string" },
          "asset_id": { "type": "string" },
          "prompt": { "type": "string" },
          "negative_prompt": { "type": "string" },
          "aspect": { "type": "string", "enum": ["16:9", "9:16"] },
          "camera_move": { "type": "string" },
          "budget": { "type": "string", "enum": ["normal", "hero"] },
          "stock_queries": { "type": "array", "items": { "type": "string" } },
          "capture_id": { "type": ["string", "null"] },
          "mock": { "type": "boolean" }
        }
      }
    }
  }
}
