{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "script.json",
  "type": "object",
  "required": ["id", "language", "title_working", "target_seconds", "scenes"],
  "properties": {
    "id": { "type": "string" },
    "language": { "type": "string", "const": "sr" },
    "title_working": { "type": "string" },
    "target_seconds": { "type": "number" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "narration", "sentences", "visual_intent"],
        "properties": {
          "id": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["hook", "intro", "point", "demo", "transition", "cta", "outro"]
          },
          "narration": { "type": "string" },
          "sentences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "visual_intent": { "type": "string" },
          "b_roll": { "type": "array", "items": { "type": "string" } },
          "screen_capture": { "type": ["string", "null"] },
          "on_screen_text": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
