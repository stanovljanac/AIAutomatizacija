{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "publish.json",
  "type": "object",
  "required": ["id", "title_options", "description", "tags", "status"],
  "properties": {
    "id": { "type": "string" },
    "title_options": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "chosen_title": { "type": ["string", "null"] },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "label"],
        "properties": {
          "time": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "properties": {
        "phrase": { "type": "string" },
        "template": { "type": "string" }
      }
    },
    "altered_content": { "type": "boolean", "description": "Always true for us (AI voice + AI visuals) — set 'altered content = yes' at upload (D-025)." },
    "credit_source": { "type": ["string", "null"] },
    "short": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "caption": { "type": "string", "description": "One-sentence cross-post caption + link to the long video (D-038)." }
      }
    },
    "pinned_comment": { "type": "string", "description": "Long utility text (e.g. the copy-pasteable master prompt) — not in the 3-sentence description." },
    "medium": {
      "type": "object",
      "description": "Medium cross-post (D-038): keyword-rich title + cover reuse.",
      "properties": {
        "title": { "type": "string" },
        "cover": { "type": "string" }
      }
    },
    "youtube_video_id": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["draft_pending", "uploaded_private", "published"]
    }
  }
}
