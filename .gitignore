# ── Media & heavy artifacts (NEVER commit) ────────────────────────────────
# One video = one folder under content/. Keep text/JSON/config, drop media.
content/**/audio/
content/**/video/
content/**/images/
content/**/render/
content/**/captures/
content/**/*.mp4
content/**/*.mov
content/**/*.wav
content/**/*.mp3
content/**/*.png
content/**/*.jpg
content/**/*.jpeg
content/**/*.webm
content/**/*.gif
content/**/*.webp
# Per-video voice output (segments, intermediates) — any extension.
content/**/voice/*
!content/**/voice/.gitkeep

# ── Per-video content & the idea-bank: not committed going forward ─────────
# Only the _TEMPLATE skeleton + code/docs/skills/schemas are tracked. Existing
# 001/002 stay tracked for history (owner choice); new videos (003+) are ignored.
# gitignore never untracks already-tracked files, so 001/002/ideas.json keep their
# history automatically — no `git rm`.
content/*
!content/_TEMPLATE/
!content/_TEMPLATE/**
# …but media dirs stay ignored even inside the skeleton (repo-wide convention; the
# pipeline recreates them). Only voice/.gitkeep is kept (rule above).
content/_TEMPLATE/audio/
content/_TEMPLATE/captures/
content/_TEMPLATE/images/
content/_TEMPLATE/render/
content/_TEMPLATE/video/
# The topics / idea-bank ("teme") — not committed.
pipeline/00-ideas/ideas.json

# Shared heavy assets
assets/music/*
assets/screenshots/*
!assets/music/.gitkeep
!assets/screenshots/.gitkeep
# Fonts: not committed (licensing varies); keep only the folder structure.
assets/fonts/*
!assets/fonts/.gitkeep

# Voice: models, reference samples, and the personal recording script
# (large or personal — never commit). Keep folder structure via .gitkeep.
voice/reference/*
voice/models/*
voice/RECORDING_SCRIPT.md
!voice/**/.gitkeep

# ── ML models & weights (huge; never commit — re-download / re-generate) ──
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.gguf
*.bin
*.h5
*.pb
*.npz

# ── Heavy A/V binaries anywhere in the repo ───────────────────────────────
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.tiff

# ── Node / Remotion ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/
templates/remotion/out/
templates/remotion/.cache/
templates/remotion/public/
templates/remotion/props/

# ── HyperFrames (render bake-off; opt-in block renderer) ──────────────────
templates/hyperframes/**/snapshots/
templates/hyperframes/**/renders/
templates/hyperframes/**/.hyperframes/
templates/hyperframes/**/capture/
templates/hyperframes/package-lock.json
templates/hyperframes/.bin/
templates/hyperframes/*.log

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# ── Secrets & local config (NEVER commit) ─────────────────────────────────
.env
.env.*
!.env.example
# Local project config copied from pipeline/shared/config.example.json
pipeline/shared/config.json
**/credentials.json
**/client_secret*.json
**/token.json
*.key

# ── OS / editor cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Logs, cache & temp ────────────────────────────────────────────────────
*.log
.cache/
tmp/
.tmp/

